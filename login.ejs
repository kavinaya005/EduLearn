<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PetShop — Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-gradient-to-br from-amber-50 via-rose-50 to-green-50 flex items-center justify-center">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-lg p-8">
      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold text-amber-600">PetShop</h1>
        <p class="text-sm text-gray-500">Log in to manage your furry friends' needs</p>
      </div>

      <% if (error) { %>
        <div class="mb-4 text-red-600 text-sm"><%= error %></div>
      <% } %>

      <form action="/login" method="post" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Username</label>
          <input name="username" required class="mt-1 block w-full rounded-md border-gray-200 shadow-sm focus:border-amber-400 focus:ring-amber-200" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700">Password</label>
          <input name="password" type="password" required class="mt-1 block w-full rounded-md border-gray-200 shadow-sm focus:border-amber-400 focus:ring-amber-200" />
        </div>

        <div class="flex items-center justify-between">
          <div class="text-sm text-gray-600">Don't have an account? <span class="text-amber-600 font-medium">Contact us</span></div>
        </div>

        <button type="submit" class="w-full py-2 px-4 bg-amber-500 text-white rounded-md hover:bg-amber-600">Sign in</button>
      </form>

      <div class="mt-6 text-center text-xs text-gray-400">Demo credentials: <strong>customer / pets123</strong></div>
    </div>
  </body>
</html>
