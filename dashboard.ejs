<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PetShop — Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-gradient-to-br from-green-50 via-amber-50 to-rose-50 p-8">
    <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-amber-600">Welcome, <%= user.name %>!</h2>
        <form action="/logout" method="post">
          <button class="py-1 px-3 bg-red-100 text-red-700 rounded">Log out</button>
        </form>
      </div>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 border rounded">
          <h3 class="font-semibold">Adopt a Friend</h3>
          <p class="text-sm text-gray-500">Find cats, dogs and more waiting for a home.</p>
        </div>
        <div class="p-4 border rounded">
          <h3 class="font-semibold">Orders</h3>
          <p class="text-sm text-gray-500">Track food and supplies for your pets.</p>
        </div>
        <div class="p-4 border rounded">
          <h3 class="font-semibold">Vet Appointments</h3>
          <p class="text-sm text-gray-500">Schedule check-ups with trusted vets.</p>
        </div>
      </div>
    </div>
  </body>
</html>
